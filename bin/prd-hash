#!/bin/bash
# First 8 chars of the sha256 of the `## Plan` section (up to the next `##`).
# Approval binds to this value. No section, no output — a plan that doesn't exist can't be approved.
set -u
file="${1:-.claude/prd.md}"
[ -f "$file" ] || exit 0
body=$(awk '/^## Plan[[:space:]]*$/{f=1;next} /^## /{f=0} f' "$file" | sed 's/[[:space:]]*$//')
[ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ] && exit 0
printf '%s' "$body" | shasum -a 256 2>/dev/null | cut -c1-8
