#!/bin/bash
# 지금 작업트리의 sha256 앞 8자 — 추적 파일의 diff + 미추적 파일 내용.
# 검수 뒤에 코드가 바뀌면 값이 달라져 `REVIEWED ok tree#…` 가 자동으로 무효가 된다.
set -u
cd "${1:-.}" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { printf 'nogit'; exit 0; }
{
  git diff HEAD 2>/dev/null
  git ls-files --others --exclude-standard -z 2>/dev/null | while IFS= read -r -d '' f; do
    printf '=== %s\n' "$f"; cat "$f" 2>/dev/null
  done
} | shasum -a 256 2>/dev/null | cut -c1-8
